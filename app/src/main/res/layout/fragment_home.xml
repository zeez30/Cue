<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App title bar (pixel aesthetic — no elevated toolbar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/text_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cue"
                android:textColor="@color/accent_tan"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"/>

            <!-- Pixel-style decoration block -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/coral"/>

            <View
                android:layout_width="2dp"
                android:layout_height="10dp"/>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/grape"/>
        </LinearLayout>

        <!-- Daily affirmation card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_tan"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦ TODAY\'S AFFIRMATION"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/text_affirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    android:textColor="@color/cream"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.5"
                    android:fontFamily="serif"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stats row: streak + satisfaction -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Streak tile -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/mint"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/text_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/accent_tan"
                        android:textSize="32sp"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:id="@+id/text_streak_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="days streak"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Satisfaction tile -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/mint"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/text_satisfaction_avg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/accent_tan"
                        android:textSize="26sp"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="avg satisfaction"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Recent meals indicator -->
        <TextView
            android:id="@+id/text_recent_meal_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <!-- SECTION LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ACTIONS"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginBottom="10dp"/>

        <!-- Hunger check-in tile -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_hunger_checkin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/forest_deep"
            app:cardElevation="0dp"
            app:strokeColor="@color/coral"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Pixel icon block -->
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="◈"
                    android:textColor="@color/coral"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:fontFamily="monospace"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HUNGER CHECK-IN"
                        android:textColor="@color/cream"
                        android:textSize="13sp"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How are you feeling right now?"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/coral"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Log meal tile -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_log_meal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/forest_deep"
            app:cardElevation="0dp"
            app:strokeColor="@color/mint"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="◉"
                    android:textColor="@color/grape"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:fontFamily="monospace"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOG A MEAL"
                        android:textColor="@color/cream"
                        android:textSize="13sp"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No calories — just experience"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/grape"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Journal tile -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_journal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/forest_deep"
            app:cardElevation="0dp"
            app:strokeColor="@color/mustard"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="◇"
                    android:textColor="@color/mustard"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:fontFamily="monospace"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BODY JOURNAL"
                        android:textColor="@color/cream"
                        android:textSize="13sp"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Body cues &amp; reflections"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/mustard"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!-- Helplines button — bottom of home screen -->
        <Button
            android:id="@+id/btn_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="NEED TO TALK TO SOMEONE?"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            style="@style/Widget.Cue.PixelButtonOutlined"/>
    </LinearLayout>
</ScrollView>
