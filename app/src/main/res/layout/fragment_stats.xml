<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- brief hint so users know what this screen does -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your check-in and meal patterns from the last 7 days."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"/>
        <!-- Screen header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSIGHTS"
            android:textColor="@color/mustard"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patterns from the last 7 days. Curiosity, not judgement."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- HUNGER TREND CHART -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/coral"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="◈ AVG HUNGER LEVEL — 7 DAYS"
                    android:textColor="@color/coral"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = very hungry · 5 = neutral · 10 = very full"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginBottom="12dp"/>

                <com.zeez.nourishquest.ui.widget.PixelBarChartView
                    android:id="@+id/chart_hunger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SATISFACTION TREND CHART -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/grape"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="◉ MEAL SATISFACTION — 7 DAYS"
                    android:textColor="@color/grape"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Average satisfaction rating per day (1–10)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginBottom="12dp"/>

                <com.zeez.nourishquest.ui.widget.PixelBarChartView
                    android:id="@+id/chart_satisfaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- EMOTIONAL STATE BREAKDOWN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/mustard"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="◇ EMOTIONAL STATES AT MEALTIMES"
                    android:textColor="@color/mustard"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How you were feeling when you logged meals. All feelings are valid."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Empty state -->
                <TextView
                    android:id="@+id/text_emotion_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Log some meals to see your emotional patterns here."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <!-- Chart container -->
                <LinearLayout
                    android:id="@+id/container_emotion_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.zeez.nourishquest.ui.widget.PixelBarChartView
                        android:id="@+id/chart_emotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Research note footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="These patterns are for your awareness only. No data leaves this device."
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
