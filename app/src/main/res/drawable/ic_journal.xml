<?xml version="1.0" encoding="utf-8"?>
<!--
    Pixel-art journal/book icon. Spine in the centre, two pages either side,
    ruled lines suggesting writing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Left page -->
    <path
        android:fillColor="@color/accent_tan"
        android:pathData="M2,3 H11 V21 H2 Z"/>

    <!-- Right page -->
    <path
        android:fillColor="@color/accent_tan"
        android:pathData="M13,3 H22 V21 H13 Z"/>

    <!-- Spine (dark gap) -->
    <path
        android:fillColor="@color/surface_dark"
        android:pathData="M11,3 H13 V21 H11 Z"/>

    <!-- Left ruled lines -->
    <path
        android:fillColor="@color/surface_card"
        android:pathData="M4,7 H9 V8 H4 Z M4,10 H9 V11 H4 Z M4,13 H9 V14 H4 Z M4,16 H9 V17 H4 Z"/>

    <!-- Right ruled lines -->
    <path
        android:fillColor="@color/surface_card"
        android:pathData="M15,7 H20 V8 H15 Z M15,10 H20 V11 H15 Z M15,13 H20 V14 H15 Z M15,16 H20 V17 H15 Z"/>

</vector>
